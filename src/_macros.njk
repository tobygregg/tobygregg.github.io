{# Reusable bits. Facebook icon + news card. #}
{% macro fb(extra) %}<svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 {{ extra }}" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>{% endmacro %}

{# NEWS CARD: text on the left + image on the right when an image is set; text-only card with an accent bar when not #}
{% macro newsCard(n) %}
<article class="grid overflow-hidden rounded-3xl bg-white shadow-[0_16px_40px_-16px_rgba(11,53,196,.3)] {% if n.image %}md:grid-cols-5{% else %}border-l-8 border-aqua{% endif %}" data-reveal>
  <div class="flex flex-col justify-center p-6 md:p-8 {% if n.image %}md:col-span-3{% endif %}">
    <p class="text-sm font-semibold text-volt"><time datetime="{{ n.iso }}">{{ n.nice }}</time></p>
    <h3 class="mt-2 font-display text-xl font-extrabold text-navy md:text-2xl"><a href="{{ n.url }}" class="hover:text-volt">{{ n.title }}</a></h3>
    {% if n.summary %}<p class="mt-3 text-navy/70">{{ n.summary }}</p>{% endif %}
    {% if n.body %}<a href="{{ n.url }}" class="mt-6 inline-flex w-fit items-center gap-2 font-bold text-volt hover:text-navy">Read more <span aria-hidden="true">→</span></a>{% endif %}
  </div>
  {% if n.image %}<div class="ph order-first h-52 md:order-last md:col-span-2 md:h-auto md:min-h-[256px]" data-label="{{ n.image }}"><img src="{{ n.image }}" alt="{{ n.title }}" loading="lazy" onerror="this.remove()"></div>{% endif %}
</article>
{% endmacro %}
